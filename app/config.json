{
  "_comment": "Brain Intake configuration. This file is tracked in git, so every change to the data boundary leaves an audit trail.",
  "host": "127.0.0.1",
  "port": 8765,
  "allow_cloud": false,
  "local": {
    "url": "http://127.0.0.1:11434",
    "default_model": "gemma3:27b",
    "num_ctx": 32768,
    "temperature": 0.2,
    "keep_alive": "5m"
  },
  "cloud": {
    "default_provider": "anthropic",
    "anthropic": {
      "model": "claude-sonnet-5-5",
      "deep_model": "claude-opus-5-5",
      "max_tokens": 8000,
      "keychain_service": "brain-intake-anthropic",
      "env": "ANTHROPIC_API_KEY"
    },
    "openai": {
      "model": "",
      "max_tokens": 8000,
      "keychain_service": "brain-intake-openai",
      "env": "OPENAI_API_KEY"
    }
  },
  "limits": {
    "max_upload_mb": 50,
    "chunk_chars": 40000,
    "max_chunks": 8,
    "max_quote_chars": 300
  },
  "rag": {
    "embed_model": "embeddinggemma",
    "answer_model": "gemma3:4b",
    "num_ctx": 8192,
    "temperature": 0.1,
    "keep_alive": "10m",
    "k": 6,
    "reindex_seconds": 120,
    "min_similarity": 0.3,
    "num_predict": 600,
    "answer_seconds": 180,
    "query_timeout": 3,
    "relative_similarity": 0.8
  },
  "auto": {
    "_comment": "Drop intake: rules set a floor, the decision model judges above it, the gates verify, and every drop is one commit that Undo reverses.",
    "decision_model": "jan-v1:4b",
    "decision_seconds": 240,
    "keep_alive": "5m",
    "num_ctx": 12288,
    "notes_per_call": 6,
    "client_domains": ["engagement-ora", "energy-neso"],
    "client_markers": ["confidential", "commercial in confidence", "official-sensitive", "official sensitive",
                       "do not distribute", "not for distribution", "under nda", "restricted", "internal use only"],
    "duplicate_similarity": 0.93,
    "domain_margin": 0.03,
    "filed_status": "draft",
    "register_people": true
  }
}
